# 必填：DeepSeek 的 API key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 可选：模型名。默认 deepseek-chat。
SERENE_MODEL=deepseek-chat

# 可选：换个端口。默认 4310。
# SERENE_PORT=4310

# 可选：监听地址。默认只监听本机。
# SERENE_HOST=127.0.0.1

# 可选：数据目录（聊天 / 记忆 / 情绪）。默认 ./data
# SERENE_DATA_DIR=./data

# 可选：人格包目录（persona.json + *.md）。默认 ./personas/serene
# SERENE_PERSONA=./personas/serene

# 可选：专名锚点模式 latin / rare / off。默认 latin
# SERENE_MEMORY_ANCHORS=latin
